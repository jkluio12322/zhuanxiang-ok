/* VOFA CSV 遥测：50 ms 中断 telemetry_publish() 纯赋值填字段置 fresh，主循环
   telemetry_send() 临界区拷副本+清 fresh 再 snprintf 发送（格式化 10 个浮点要
   100~300 µs，放进中断会压住串口丢字节）。行尾只发 \n、通道全 float，
   与参考工程 c8t6-963ra 一致，VOFA+ FireWater 才稳定滚动。一致性靠临界区整体拷贝，fresh 只回答"有无
   新数据"。读 motion_view()/imu_get() 只读视图是只读跨层，避免填遥测传 10 个参数。 */

#include "telemetry.h"
#include "config.h"
#include "imu.h"
#include "motion.h"
#include "serial.h"
#include "state.h"
#include "testmode.h"
#include "track.h"

#include <math.h>
#include <stdio.h>
#include <string.h>

/* 遥测快照本体。写它的只有本文件的 Publish()，读它的有 Send() 和显示模块。 */
telemetryData_t telemetry_data;

/* 把遥测快照格式化为 VOFA CSV 并发送（主循环，deferred_run 调用）。发送优先级：
   VOFA 关不发；有停车事件发 [STOP]（绕过零转速抑制，只有整行写进发送缓冲才清事件）；
   只要 VOFA 开着就每 50 ms 发一帧，不看新旧、不看车是否在跑。读快照+清标志在临界区做。 */
void telemetry_send(void)
{
    StopReason stopReason;
    telemetryData_t snapshot;

    if (!state_view()->vofa) return;

    /* 停车事件只清标志、不再往串口写 "#STOP ..."。FireWater 是纯 CSV 引擎，
       任何非 16 字段数字行都会打乱它的通道解析（实测表现为波形只画几帧就停）。
       停车原因显示在 OLED 和命令行里就够了。 */
    if (state_take_stop_event(&stopReason)) {
        state_clear_stop_event();
        (void)stopReason;
    }

    /* 只要 VOFA 在线就每 50 ms 发一帧：不再看"有没有新数据"、也不再看车是否在跑。
       即使车停着、即使速度环一分钟没 publish，也把当前快照照发，波形就是一条平线，
       连上串口立刻有数据。快照本身由 50 ms 节拍的 publish()/heartbeat() 持续刷新。 */

    /* 整体拷贝 + 清标志放在同一个临界区里，之后一律从副本格式化。
       顺序很关键：先清标志再逐个读字段的话，标志根本保护不了快照。 */
    {
        uint32_t primask = __get_PRIMASK();

        __disable_irq();
        snapshot = telemetry_data;
        telemetry_data.fresh = 0;
        __set_PRIMASK(primask);
    }

    char buffer[TELEMETRY_BUFFER_SIZE];
    int length;

    /* 与可用参考工程 c8t6-963ra（Core/Extend/C_Cpp/imu_app.c 里 Serial_Printf）完全对齐：
       纯 float、固定 10 通道、行尾只发 \n 不发 \r。VOFA+ 的 FireWater 引擎按行解析，
       混入 int 字段或 \r 会打乱通道模板，实测表现为"有数据但波形不滚动"。
       顺序：tgtRpmL,rpmL,tgtRpmR,rpmR,voltL,voltR,steerRpm,diffRpm,yawDeg,trackErr。 */
    length = snprintf(buffer, sizeof(buffer),
        "%.1f,%.1f,%.1f,%.1f,%.2f,%.2f,%.1f,%.1f,%.1f,%.1f\n",
        snapshot.targetLeftRpm,
        snapshot.filteredLeftRpm,
        snapshot.targetRightRpm,
        snapshot.filteredRightRpm,
        snapshot.commandVoltageLeft,
        snapshot.commandVoltageRight,
        snapshot.steerRpm,
        snapshot.actualDiffRpm,
        snapshot.yawAngleDeg,
        snapshot.trackError);

    if (length > 0 && length < (int)sizeof(buffer)) {
        serial_write((const uint8_t *)buffer, (uint16_t)length);
    }
}

/* 用本周期控制结果填充遥测快照（中断上下文，50 ms 控制任务调用，只赋值不格式化）。
   参数单位 RPM/百分比；速度与姿态字段直接读只读视图，其余由调用方传入。最后置 fresh=1
   是通知主循环"有新快照可发"的唯一入口。commandVoltage 是 PWM 百分比按标称电压换算的
   近似值，仅供观察趋势（本工程无母线电压采样）。 */
void telemetry_publish(float targetLeft, float targetRight,
                          int16_t leftPwm, int16_t rightPwm,
                          float steerRpm, float trackError,
                          int16_t turnPhase, float rpmDifference)
{
    telemetry_data.targetLeftRpm = targetLeft;
    telemetry_data.targetRightRpm = targetRight;
    telemetry_data.actualLeftRpm = motion_view()->left_rpm_raw;
    telemetry_data.actualRightRpm = motion_view()->right_rpm_raw;
    telemetry_data.filteredLeftRpm = motion_view()->left_rpm;
    telemetry_data.filteredRightRpm = motion_view()->right_rpm;
    telemetry_data.steerRpm = steerRpm;
    telemetry_data.actualDiffRpm = rpmDifference;
    telemetry_data.yawAngleDeg = imu_get()->yaw;
    telemetry_data.trackError = trackError;
    telemetry_data.mode = (int16_t)state_view()->mode;
    telemetry_data.runFlag = state_view()->running;
    telemetry_data.gear = (int16_t)state_view()->gear;
    telemetry_data.turnPhase = turnPhase;
    telemetry_data.commandVoltageLeft =
        (float)leftPwm * MOTOR_SUPPLY_VOLTAGE / 100.0f;
    telemetry_data.commandVoltageRight =
        (float)rightPwm * MOTOR_SUPPLY_VOLTAGE / 100.0f;
    telemetry_data.fresh = 1;
}

/* 空闲心跳：控制任务在 !running 时提前返回、不产生快照，于是 VOFA+ 里一片空白、看起来像
   "收不到数据"。这里每 50 ms 用当前视图填一帧（目标速度为 0，实测/占空比/循迹量照实给），
   并直接刷新快照。三种模式（TRACK / PWM-SPD / PWM-TRK）都走这一条路，
   所以任何模式下 VOFA 都有连续数据。 */
void telemetry_heartbeat(void)
{
    float leftPwm;
    float rightPwm;

    telemetry_data.targetLeftRpm = 0.0f;
    telemetry_data.targetRightRpm = 0.0f;
    telemetry_data.actualLeftRpm = motion_view()->left_rpm_raw;
    telemetry_data.actualRightRpm = motion_view()->right_rpm_raw;
    telemetry_data.filteredLeftRpm = motion_view()->left_rpm;
    telemetry_data.filteredRightRpm = motion_view()->right_rpm;
    telemetry_data.steerRpm = track_get_steer();
    telemetry_data.actualDiffRpm = motion_view()->left_rpm - motion_view()->right_rpm;
    telemetry_data.yawAngleDeg = imu_get()->yaw;
    telemetry_data.trackError = track_output()->e_y;
    telemetry_data.mode = (int16_t)state_view()->mode;
    telemetry_data.runFlag = state_view()->running;
    telemetry_data.gear = (int16_t)state_view()->gear;
    telemetry_data.turnPhase = (int16_t)testmode_get_track_phase();

    /* 占空比照实换算，PWM-SPD 手动开环时 voltL/voltR 就是当前输出。 */
    leftPwm = (float)motion_view()->left_pwm;
    rightPwm = (float)motion_view()->right_pwm;
    telemetry_data.commandVoltageLeft = leftPwm * MOTOR_SUPPLY_VOLTAGE / 100.0f;
    telemetry_data.commandVoltageRight = rightPwm * MOTOR_SUPPLY_VOLTAGE / 100.0f;
    telemetry_data.fresh = 1;
}

/* 发送开机横幅和 VOFA CSV 表头。字段顺序必须与 telemetry_send() 格式串一致，
   这里是表头唯一来源，不要在别处硬编码。 */
void telemetry_boot_header(void)
{
    /* 刻意不发任何文本横幅：VOFA+ 的 FireWater 引擎只接受纯 CSV 行，
       之前发的 "#BOOT OK" 和 16 个英文通道名会被当成数据行解析，
       导致通道错位、波形只出现几帧就消失。通道含义见 telemetry.h 的字段顺序表。 */
}

/* 初始化遥测快照：全部字段清零，保证首次发送前数据有效。 */
void telemetry_init(void)
{
    memset(&telemetry_data, 0, sizeof(telemetry_data));
}
