/* 非阻塞按键状态机：20 ms 轮询采样（两级稳定确认）生成按下/抬起沿，
   再合成短按/长按/双击/连发。
   引脚：K1=PG2、K2=PG3、K3=PD14、K4=PD15，全部输入上拉，按下=低电平。
   为什么改轮询：拓展板按键经排母引出，不再接 EXTI；轮询同时消除了原 EXTI 回调里
   HAL_GPIO_ReadPin(GPIOC, ...) 硬编码端口的隐患。 */

#include "key.h"

/* 双击窗口拍数：0 = 双击不可达（有意禁用，全工程无 KEY_DOUBLE 消费者） */
#define KEY_TIME_DOUBLE  0

/* 长按判定时间，单位拍（key_tick 20 ms 一次，50 拍 = 1 s） */
#define KEY_TIME_LONG    50

/* 长按连发周期，单位拍（5 拍 = 100 ms） */
#define KEY_TIME_REPEAT  5

/* 连续多少拍电平一致才认定为稳定状态（2 拍 = 40 ms 消抖） */
#define KEY_STABLE_CNT   2

typedef struct
{
    GPIO_TypeDef *port;
    uint16_t      pin;
} key_hw_t;

static const key_hw_t k_hw[KEY_COUNT] =
{
    { K1_GPIO_Port, K1_Pin },
    { K2_GPIO_Port, K2_Pin },
    { K3_GPIO_Port, K3_Pin },
    { K4_GPIO_Port, K4_Pin },
};

/* 跨上下文访问须 volatile：20 ms 任务写，主循环 key_check() 读 */
volatile uint8_t key_flag[KEY_COUNT];

void key_init(void) {}   /* 无需初始化，GPIO 由 MX_GPIO_Init 配置 */

uint8_t key_check(uint8_t n, uint8_t Flag)   /* 查询事件；除 KEY_HOLD 外读后自动清除 */
{
    if (key_flag[n] & Flag) {
        if (Flag != KEY_HOLD)
            key_flag[n] &= ~Flag;
        return 1;
    }
    return 0;
}

uint8_t key_check_single_or_long(uint8_t n)   /* 取一次短按或长按，并清除连发标志 */
{
    uint8_t event = 0U;

    if (n >= KEY_COUNT) return 0U;

    if (key_flag[n] & KEY_SINGLE) {
        key_flag[n] &= ~KEY_SINGLE;
        event = 1U;
    } else if (key_flag[n] & KEY_LONG) {
        key_flag[n] &= ~KEY_LONG;
        event = 1U;
    }

    key_flag[n] &= ~KEY_REPEAT;
    return event;
}

void key_clear(void)   /* 清除所有事件标志 */
{
    for (uint8_t i = 0; i < KEY_COUNT; i++)
        key_flag[i] = 0;
}

/* 采样四路按键并做两级稳定确认，等价于原来的 EXTI 回调：
   稳定按下 -> 置 DOWN + HOLD；稳定抬起 -> 清 HOLD + 置 UP。 */
static void key_poll(void)
{
    static uint8_t level[KEY_COUNT];   /* 已确认电平：1 = 按下（低） */
    static uint8_t cnt[KEY_COUNT];     /* 与已确认电平相反时的连续采样计数 */

    for (uint8_t i = 0; i < KEY_COUNT; i++) {
        uint8_t raw = (HAL_GPIO_ReadPin(k_hw[i].port, k_hw[i].pin) == GPIO_PIN_RESET) ? 1U : 0U;

        if (raw == level[i]) {
            cnt[i] = 0U;
            continue;
        }
        if (++cnt[i] >= KEY_STABLE_CNT) {
            cnt[i]   = 0U;
            level[i] = raw;
            if (raw) {
                key_flag[i] |= KEY_DOWN;
                key_flag[i] |= KEY_HOLD;
            } else {
                key_flag[i] &= (uint8_t)~KEY_HOLD;
                key_flag[i] |= KEY_UP;
            }
        }
    }
}

/* 采样 + 计时状态机，20 ms 调用一次 */
void key_tick(void)
{
    static uint8_t  S[KEY_COUNT];
    static uint16_t Time[KEY_COUNT];

    key_poll();

    for (uint8_t i = 0; i < KEY_COUNT; i++) {
        if (Time[i] > 0) Time[i]--;

        uint8_t just_dn  = (key_flag[i] & KEY_DOWN) != 0;
        uint8_t just_up  = (key_flag[i] & KEY_UP)   != 0;

        if (just_dn) key_flag[i] &= ~KEY_DOWN;
        if (just_up) key_flag[i] &= ~KEY_UP;

        switch (S[i]) {
        case 0:  /* 空闲 */
            if (just_dn) { Time[i] = KEY_TIME_LONG; S[i] = 1; }
            break;
        case 1:  /* 按住中 */
            if (just_up) { Time[i] = KEY_TIME_DOUBLE; S[i] = 2; }
            else if (Time[i] == 0) {
                Time[i] = KEY_TIME_REPEAT;
                key_flag[i] |= KEY_LONG;
                S[i] = 4;
            }
            break;
        case 2:  /* 已释放, 等待双击 */
            if (just_dn) { key_flag[i] |= KEY_DOUBLE; S[i] = 3; }
            else if (Time[i] == 0) { key_flag[i] |= KEY_SINGLE; S[i] = 0; }
            break;
        case 3:  /* 双击后等待释放 */
            if (just_up) S[i] = 0;
            break;
        case 4:  /* 长按连发 */
            if (just_up) S[i] = 0;
            else if (Time[i] == 0) {
                Time[i] = KEY_TIME_REPEAT;
                key_flag[i] |= KEY_REPEAT;
            }
            break;
        }
    }
}

/* 非阻塞按键查询：每次调用立即返回，不延时、不等松手。
   0 = 暂无结论（没按 / 还在消抖 / 已确认过 / 还按着等松开）；
   1~4 = 刚完成一次"按下-保持 20 ms-松开"的完整动作，返回键号。
   按住超过 KEY_GET_HOLD_MS 也强制出结果，避免永远停在等待松开。
   调用方每轮主循环调一次即可，不会占用任何等待时间。 */
#define KEY_GET_DEBOUNCE_MS  20U
#define KEY_GET_HOLD_MS      2000U

uint8_t key_get_num(void)
{
    static uint8_t  state;   /* 0 = 找按下，1 = 消抖确认，2 = 等松开 */
    static uint8_t  index;   /* 当前跟踪的键，0 基 */
    static uint32_t t0;

    uint32_t now = HAL_GetTick();

    if (state == 0U) {
        for (uint8_t i = 0; i < KEY_COUNT; i++) {
            if (HAL_GPIO_ReadPin(k_hw[i].port, k_hw[i].pin) == GPIO_PIN_RESET) {
                index = i;
                t0    = now;
                state = 1U;
                return 0U;
            }
        }
        return 0U;
    }

    if (state == 1U) {
        if (HAL_GPIO_ReadPin(k_hw[index].port, k_hw[index].pin) != GPIO_PIN_RESET) {
            state = 0U;                       /* 抖动，作废 */
            return 0U;
        }
        if ((now - t0) < KEY_GET_DEBOUNCE_MS) return 0U;
        state = 2U;
        return 0U;
    }

    /* state == 2：等松开，超时也放行 */
    if ((HAL_GPIO_ReadPin(k_hw[index].port, k_hw[index].pin) != GPIO_PIN_RESET) ||
        ((now - t0) >= KEY_GET_HOLD_MS)) {
        state = 0U;
        return (uint8_t)(index + 1U);
    }
    return 0U;
}
